# Forge environment variables
# Add application-specific secrets here as integrations are introduced.
NODE_ENV=development

# Server-side only. Meal-photo analysis remains unavailable when OPENAI_API_KEY is empty.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6-luna
USDA_FOODDATA_API_KEY=DEMO_KEY
MEAL_PHOTO_HOURLY_LIMIT=10

# Founder-only web control. Leave false in public deployments unless the operations panel is intended for that build.
VITE_FORGE_OPERATIONS_ENABLED=false
