# Optional Sprint 4.3 sync service. Without both values Forge remains local-first.
VITE_FORGE_SYNC_URL=https://api.example.com

# Optional for non-Vite integration testing. Vite development always uses the
# API's matched local-development token. Production must obtain a short-lived
# access token from the authenticated session; never ship a permanent shared
# secret in a VITE_ value.
VITE_FORGE_SYNC_TOKEN=replace-with-development-token

# Production Entra External ID configuration. Omit all three locally to keep
# using the built-in development identity.
VITE_ENTRA_CLIENT_ID=your-spa-application-client-id
VITE_ENTRA_AUTHORITY=https://yourtenant.ciamlogin.com/yourtenant.onmicrosoft.com
VITE_ENTRA_API_SCOPE=api://your-api-application-client-id/access_as_user
# VITE_ENTRA_REDIRECT_URI=https://app.forge.example.com
