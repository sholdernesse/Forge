{
  "name": "@forge/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc -p tsconfig.json --noEmit",
    "dev": "node --watch --enable-source-maps dist/server.js",
    "dev:https": "node --watch --enable-source-maps dist/server.js",
    "start": "node --enable-source-maps dist/server.js",
    "migrate": "node --enable-source-maps dist/migrate.js"
  },
  "dependencies": {
    "jose": "^6.1.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
