PORT=8787
DATABASE_URL=postgresql://forge:forge@localhost:5432/forge
DATABASE_SSL=disable
DATABASE_POOL_SIZE=10
FORGE_WEB_ORIGIN=http://localhost:4173
USDA_FOODDATA_API_KEY=

# Local development only. Production refuses this path.
FORGE_DEV_TOKEN=replace-with-a-long-random-development-token
FORGE_DEV_USER_ID=forge-development-user

# Required in production. The JWT subject becomes the database user_id.
OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=https://api.forge.example.com
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OIDC_REQUIRED_SCOPE=access_as_user
